/* module2/index.wxss - 智能排座引擎模块样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 30rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.action-buttons {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

/* 排列功能区域样式 */
.arrange-functions-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-top: 24rpx;
}

.arrange-functions-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.arrange-functions-buttons {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.action-btn {
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
  padding: 0 16rpx;
}

.action-btn:active {
  background-color: #40a9ff;
}

/* 自动排列设置模块样式 */
.auto-arrange-container {
  position: relative;
  width: 100%;
}

.auto-arrange-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: 100%;
}

.auto-arrange-btn {
  flex: 1;
}

.dropdown-icon {
  font-size: 20rpx;
  color: #666;
  transition: transform 0.3s;
  padding: 8rpx;
}

.dropdown-icon.expanded {
  transform: rotate(180deg);
}

.auto-arrange-settings {
  margin-top: 20rpx;
  padding: 24rpx;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-out;
}

.auto-arrange-settings.show {
  max-height: 800rpx;
}

.settings-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

.weight-item {
  margin-bottom: 32rpx;
}

.weight-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.weight-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.weight-value {
  font-size: 26rpx;
  color: #1890ff;
  font-weight: 600;
  min-width: 60rpx;
  text-align: right;
}

.weight-slider {
  width: 100%;
  margin: 16rpx 0;
}

.weight-desc {
  margin-top: 8rpx;
}

.desc-text {
  font-size: 22rpx;
  color: #999;
}

.save-settings-btn {
  width: 100%;
  margin-top: 24rpx;
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  border: none;
}

.save-settings-btn:active {
  background-color: #40a9ff;
}

.seat-cell.dragging-mode {
  border-style: dashed;
  border-color: #1890ff;
  background-color: #e6f7ff;
}

.seat-cell.dragging-mode.empty {
  background-color: #f0f9ff;
}

/* 待排列区域样式 */
.unassigned-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-top: 24rpx;
}

.unassigned-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.unassigned-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  min-height: 100rpx;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.student-tag {
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  cursor: pointer;
  user-select: none;
  touch-action: none;
  border: 2rpx solid;
}

/* 男生标签（蓝色） */
.student-tag.male {
  background-color: #e6f7ff;
  border-color: #1890ff;
  color: #1890ff;
}

/* 女生标签（红色） */
.student-tag.female {
  background-color: #fff1f0;
  border-color: #ff4d4f;
  color: #ff4d4f;
}

/* 选中状态 - 男生 */
.student-tag.male.selected {
  background-color: #bae7ff;
  border-color: #1890ff;
  transform: scale(1.05);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

/* 选中状态 - 女生 */
.student-tag.female.selected {
  background-color: #ffccc7;
  border-color: #ff4d4f;
  transform: scale(1.05);
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3);
}

/* 选中状态 - 男生座位 */
.seat-cell.selected.male {
  border-color: #1890ff;
  border-width: 3rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
  transform: scale(1.05);
}

/* 选中状态 - 女生座位 */
.seat-cell.selected.female {
  border-color: #ff4d4f;
  border-width: 3rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3);
  transform: scale(1.05);
}

/* 选中状态 - 默认（空座位或没有性别信息） */
.seat-cell.selected {
  border-color: #1890ff;
  border-width: 3rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
  transform: scale(1.05);
}

/* 弹窗样式 */
.layout-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  padding: 0 10rpx;
}

.modal-body {
  padding: 30rpx;
}

.input-group {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  width: 120rpx;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  padding: 16rpx 20rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.input-field:focus {
  border-color: #1890ff;
}

.modal-tips {
  padding: 20rpx;
  background-color: #f0f9ff;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.modal-tips text {
  font-size: 24rpx;
  color: #1890ff;
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  font-size: 28rpx;
  border: none;
  border-radius: 0;
  background-color: #fff;
}

.modal-btn.cancel {
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.modal-btn.confirm {
  color: #1890ff;
  font-weight: 600;
}

.modal-btn:active {
  background-color: #f5f5f5;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.stats-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  justify-content: space-around;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #666;
}

.stats-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1890ff;
}

.seat-table-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.seat-table-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

/* 座位表滚动容器 */
.seat-table-scroll {
  width: 100%;
  white-space: nowrap;
  overflow-x: auto;
}

.seat-table {
  display: inline-flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: max-content;
}

.seat-row {
  display: flex;
  gap: 12rpx;
  justify-content: flex-start;
  align-items: flex-start;
  flex-shrink: 0;
}

/* 大组容器 */
.seat-group {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 大组之间的间隙 */
.seat-group-gap {
  width: 40rpx;
  flex-shrink: 0;
}

.seat-cell {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* 空座位样式 */
.seat-cell.empty {
  background-color: #f5f5f5;
  border-color: #d9d9d9;
}

/* 已填满座位 - 男生（蓝色） */
.seat-cell.occupied.male {
  background-color: #e6f7ff;
  border-color: #1890ff;
}

/* 已填满座位 - 女生（红色） */
.seat-cell.occupied.female {
  background-color: #fff1f0;
  border-color: #ff4d4f;
}

/* 已填满座位 - 默认（如果没有性别信息，使用蓝色） */
.seat-cell.occupied {
  background-color: #e6f7ff;
  border-color: #1890ff;
}

.seat-content {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
}

.seat-text {
  font-size: 24rpx;
  color: #333;
  word-break: break-all;
}

.seat-content-empty {
  color: #999;
}

.seat-content-empty .seat-text,
.seat-text-empty {
  color: #999;
}

.info-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-content text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
