/* module2/index.wxss - 智能排座引擎模块样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 30rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.header-buttons {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.action-btn {
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
  padding: 0 16rpx;
}

.action-btn:active {
  background-color: #40a9ff;
}

.seat-cell.dragging-mode {
  border-style: dashed;
  border-color: #1890ff;
  background-color: #e6f7ff;
}

.seat-cell.dragging-mode.empty {
  background-color: #f0f9ff;
}

/* 待排列区域样式 */
.unassigned-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-top: 24rpx;
}

.unassigned-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.unassigned-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  min-height: 100rpx;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.student-tag {
  padding: 12rpx 20rpx;
  background-color: #e6f7ff;
  border: 2rpx solid #91d5ff;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #1890ff;
  cursor: pointer;
  user-select: none;
  touch-action: none;
}

.student-tag.selected {
  background-color: #bae7ff;
  border-color: #1890ff;
  transform: scale(1.05);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.seat-cell.selected {
  border-color: #1890ff;
  border-width: 3rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
  transform: scale(1.05);
}

/* 弹窗样式 */
.layout-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  padding: 0 10rpx;
}

.modal-body {
  padding: 30rpx;
}

.input-group {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  width: 120rpx;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  padding: 16rpx 20rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.input-field:focus {
  border-color: #1890ff;
}

.modal-tips {
  padding: 20rpx;
  background-color: #f0f9ff;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.modal-tips text {
  font-size: 24rpx;
  color: #1890ff;
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  font-size: 28rpx;
  border: none;
  border-radius: 0;
  background-color: #fff;
}

.modal-btn.cancel {
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.modal-btn.confirm {
  color: #1890ff;
  font-weight: 600;
}

.modal-btn:active {
  background-color: #f5f5f5;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.stats-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  justify-content: space-around;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #666;
}

.stats-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1890ff;
}

.seat-table-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.seat-table-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

.seat-table {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.seat-row {
  display: flex;
  gap: 12rpx;
  justify-content: center;
}

.seat-cell {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
}

.seat-cell.occupied {
  background-color: #e6f7ff;
  border-color: #1890ff;
}

.seat-cell.empty {
  background-color: #f5f5f5;
  border-color: #d9d9d9;
}

.seat-name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  word-break: break-all;
  padding: 8rpx;
}

.seat-empty {
  font-size: 24rpx;
  color: #999;
}

.info-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-content text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
