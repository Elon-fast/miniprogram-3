<!--module2/index.wxml - 智能排座引擎模块-->
<view class="container">
  <view class="header">
    <text class="title">{{title}}</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 座位表 -->
  <view class="content" wx:if="{{!loading && showSeatTable && seatTable}}">
    <!-- 统计信息 -->
    <view class="stats-card" wx:if="{{seatStats}}">
      <view class="stats-item">
        <text class="stats-label">总座位数:</text>
        <text class="stats-value">{{seatStats.totalSeats}}</text>
      </view>
      <view class="stats-item">
        <text class="stats-label">已使用:</text>
        <text class="stats-value">{{seatStats.usedSeats}}</text>
      </view>
      <view class="stats-item">
        <text class="stats-label">空座位:</text>
        <text class="stats-value">{{seatStats.emptySeats}}</text>
      </view>
    </view>

    <!-- 座位表 -->
    <view class="seat-table-container">
      <!-- 黑板指示器 -->
      <view class="blackboard-indicator">
        <view class="blackboard-content">黑板 / 讲台</view>
      </view>
      
      <view class="seat-table-title">座位表 ({{rows}}行 × {{cols}}列)</view>
      <scroll-view class="seat-table-scroll" scroll-x="true" enable-flex="true">
        <view class="seat-table">
          <view class="seat-row" wx:for="{{seatTable}}" wx:key="index" wx:for-item="row" wx:for-index="rowIndex">
            <!-- 按照大组分组显示 -->
            <block wx:for="{{groupData}}" wx:key="startIndex" wx:for-item="group" wx:for-index="groupIndex">
              <view class="seat-group">
                <view 
                  class="seat-cell {{row[group.startIndex + colIndex] ? 'occupied' : 'empty'}} {{row[group.startIndex + colIndex] && row[group.startIndex + colIndex].gender === 'female' ? 'female' : ''}} {{row[group.startIndex + colIndex] && row[group.startIndex + colIndex].gender === 'male' ? 'male' : ''}} {{selectedSeat && selectedSeat.row === rowIndex && selectedSeat.col === (group.startIndex + colIndex) ? 'selected' : ''}}" 
                  wx:for="{{group.cols}}" 
                  wx:key="colIndex"
                  wx:for-item="col"
                  wx:for-index="colIndex"
                  data-row="{{rowIndex}}"
                  data-col="{{group.startIndex + colIndex}}"
                  bindtap="onSeatClick"
                >
                  <view class="seat-content" wx:if="{{row[group.startIndex + colIndex]}}">
                    <text class="seat-text">{{row[group.startIndex + colIndex].name}}</text>
                  </view>
                  <view class="seat-content seat-content-empty" wx:else>
                    <text class="seat-text seat-text-empty">空</text>
                  </view>
                  
                  <!-- 悬停/选中时显示的标签信息 -->
                  <view class="student-info-tooltip {{rowIndex === 0 ? 'tooltip-bottom' : ''}}" wx:if="{{(selectedSeat && selectedSeat.row === rowIndex && selectedSeat.col === (group.startIndex + colIndex)) && selectedStudentTags.length > 0}}">
                    <view class="tooltip-tag {{tag.type}}" wx:for="{{selectedStudentTags}}" wx:key="index" wx:for-item="tag">
                      {{tag.text}}
                    </view>
                  </view>
                </view>
              </view>
              <!-- 大组之间的间隙（最后一个大组后不显示） -->
              <view class="seat-group-gap" wx:if="{{groupIndex < groupData.length - 1}}"></view>
            </block>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 待排列区域（自定义模式显示） -->
    <view class="unassigned-container" wx:if="{{isCustomMode && unassignedStudents.length > 0}}">
      <view class="unassigned-title">待排列学生 ({{unassignedStudents.length}}人)</view>
      <view class="unassigned-list">
        <view 
          class="student-tag {{student.gender === 'female' ? 'female' : 'male'}} {{draggingStudent && draggingStudent.id === student.id ? 'selected' : ''}}"
          wx:for="{{unassignedStudents}}"
          wx:key="id"
          wx:for-item="student"
          data-student-id="{{student.id}}"
          bindtap="onStudentClick"
        >
          <text>{{student.name}}</text>
          
          <!-- 悬停/选中时显示的标签信息 -->
          <view class="student-info-tooltip" wx:if="{{(draggingStudent && draggingStudent.id === student.id && !dragStartSeat) && selectedStudentTags.length > 0}}">
            <view class="tooltip-tag {{tag.type}}" wx:for="{{selectedStudentTags}}" wx:key="index" wx:for-item="tag">
              {{tag.text}}
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 排列功能区域 -->
    <view class="arrange-functions-container" wx:if="{{showSeatTable}}">
      <view class="arrange-functions-title">排列功能</view>
      
      <!-- 非自定义模式：显示自定义布局和重新生成按钮 -->
      <view class="arrange-functions-buttons" wx:if="{{!isCustomMode}}">
        <button class="action-btn" bindtap="showCustomLayout" size="mini">自定义布局</button>
        <button class="action-btn" bindtap="reGenerate" size="mini">重新生成</button>
        <button class="action-btn export-btn" bindtap="exportSeatingChart" size="mini">导出座位表</button>
      </view>
      
      <!-- 自定义模式：显示自定义布局、清空排列和自动排列按钮 -->
      <view wx:if="{{isCustomMode}}">
        <view class="arrange-functions-buttons">
          <button class="action-btn" bindtap="showCustomLayout" size="mini">自定义布局</button>
          <button class="action-btn" bindtap="clearArrangement" size="mini">清空排列</button>
          <button class="action-btn" bindtap="autoArrange" size="mini">自动排列</button>
          <button class="action-btn export-btn" bindtap="exportSeatingChart" size="mini">导出座位表</button>
        </view>
        
        <!-- 自定义排列因素（点击展开设置） -->
        <view class="custom-factors-header" bindtap="toggleAutoArrangeSettings">
          <text class="custom-factors-text">自定义排列因素</text>
          <view class="dropdown-icon {{showAutoArrangeSettings ? 'expanded' : ''}}">▼</view>
        </view>
        
                <!-- 自动排列设置面板 -->
        <view class="auto-arrange-container">
          <view class="auto-arrange-settings {{showAutoArrangeSettings ? 'show' : ''}}" wx:if="{{showAutoArrangeSettings}}">
            <view class="settings-title">影响因子权重设置</view>
            
            <!-- 学科互补 -->
            <view class="weight-item">
              <view class="weight-label">
                <text class="weight-name">学科互补</text>
                <text class="weight-value">{{complementarityValue}}</text>
              </view>
              <slider 
                class="weight-slider"
                min="-1" 
                max="1" 
                step="0.1"
                value="{{autoArrangeWeights.complementarity}}"
                data-type="complementarity"
                bindchange="onWeightChange"
                activeColor="#1890ff"
                backgroundColor="#e8e8e8"
              />
              <view class="weight-desc">
                <text class="desc-text">负值：优先不互补 | 正值：优先互补</text>
              </view>
            </view>
            
            <!-- 性格相融 -->
            <view class="weight-item">
              <view class="weight-label">
                <text class="weight-name">性格相融</text>
                <text class="weight-value">{{compatibilityValue}}</text>
              </view>
              <slider 
                class="weight-slider"
                min="-1" 
                max="1" 
                step="0.1"
                value="{{autoArrangeWeights.compatibility}}"
                data-type="compatibility"
                bindchange="onWeightChange"
                activeColor="#1890ff"
                backgroundColor="#e8e8e8"
              />
              <view class="weight-desc">
                <text class="desc-text">负值：优先不相融 | 正值：优先相融</text>
              </view>
            </view>
            
            <!-- 避免干扰 -->
            <view class="weight-item">
              <view class="weight-label">
                <text class="weight-name">避免干扰</text>
                <text class="weight-value">{{interferenceValue}}</text>
              </view>
              <slider 
                class="weight-slider"
                min="-1" 
                max="1" 
                step="0.1"
                value="{{autoArrangeWeights.interference}}"
                data-type="interference"
                bindchange="onWeightChange"
                activeColor="#1890ff"
                backgroundColor="#e8e8e8"
              />
              <view class="weight-desc">
                <text class="desc-text">负值：优先有联系 | 正值：优先避免干扰</text>
              </view>
            </view>
            
            <button class="save-settings-btn" bindtap="saveAutoArrangeSettings">确定</button>
          </view>
        </view>
      </view>
    </view>

    <!-- 说明 -->
    <view class="info-card">
      <view class="info-title">💡 排座说明</view>
      <view class="info-content">
        <text class="info-text" wx:if="{{isCustomMode}}">• 自定义模式下，可以拖拽学生标签到座位进行排列</text>
        <text class="info-text" wx:if="{{isCustomMode}}">• 可以拖拽座位中的学生到其他位置进行交换</text>
        <text class="info-text" wx:if="{{isCustomMode}}">• 点击"自动排列"可将待排列学生自动分配到剩余座位</text>
        <text class="info-text" wx:if="{{!isCustomMode}}">• 算法综合考虑学科互补、性格相容、避免干扰等因素</text>
        <text class="info-text" wx:if="{{!isCustomMode}}">• 点击"重新生成"可生成不同的座位安排方案</text>
        <text class="info-text">• 空座位表示该位置未安排学生</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && !showSeatTable}}">
    <text>暂无数据</text>
  </view>
</view>

<!-- 自定义布局弹窗 -->
<view class="layout-modal" wx:if="{{showLayoutModal}}" bindtap="closeLayoutModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">自定义布局</text>
      <text class="modal-close" bindtap="closeLayoutModal">×</text>
    </view>
    <view class="modal-body">
      <view class="input-group">
        <text class="input-label">行数:</text>
        <input 
          class="input-field" 
          type="number" 
          value="{{customRows}}" 
          bindinput="onRowInput"
          placeholder="请输入行数(1-10)"
        />
      </view>
      <view class="input-group">
        <text class="input-label">列数:</text>
        <input 
          class="input-field" 
          type="number" 
          value="{{customCols}}" 
          bindinput="onColInput"
          placeholder="请输入列数(1-10)"
        />
      </view>
      <view class="input-group">
        <text class="input-label">大组列数:</text>
        <input 
          class="input-field" 
          type="text" 
          value="{{groupCols}}" 
          bindinput="onGroupColsInput"
          placeholder="如: 242 或 2"
        />
      </view>
      <view class="modal-tips">
        <text>💡 提示：</text>
        <text>• 设置行列后，所有学生将进入待排列区域，您可以手动拖拽排列</text>
        <text>• 大组列数：输入单个数字(如"2")表示每个大组都是该列数</text>
        <text>• 输入连续数字(如"242")表示从左到右每个大组的列数，总和需等于总列数</text>
      </view>
    </view>
    <view class="modal-footer">
      <button class="modal-btn cancel" bindtap="closeLayoutModal">取消</button>
      <button class="modal-btn confirm" bindtap="confirmCustomLayout">确定</button>
    </view>
  </view>
</view>

<!-- 隐藏的Canvas，用于生成图片 -->
<canvas type="2d" id="exportCanvas" style="position:fixed; left:100%; top:0; width: {{canvasWidth}}px; height: {{canvasHeight}}px; opacity: 0; pointer-events: none;"></canvas>
