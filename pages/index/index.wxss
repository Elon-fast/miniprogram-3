/**index.wxss - 主页样式**/
.page-container {
  min-height: 100vh;
  padding: 40rpx 30rpx;
  background: linear-gradient(to bottom, #f8f9fa, #f5f5f5);
}

/* 通用区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
  border-left: 4rpx solid #1890ff;
}

/* 班级选择器区域 */
.class-selector-section {
  margin-bottom: 40rpx;
}

.class-picker {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.picker-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  line-height: 88rpx;
}

.picker-label {
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

/* 用户信息区域 */
.user-info-section {
  margin-bottom: 40rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 3rpx solid #f0f0f0;
}

.user-avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 60rpx;
}

.user-details {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.user-role {
  font-size: 26rpx;
  color: #999;
}

/* 功能模块区域 */
.modules-section {
  margin-bottom: 40rpx;
}

.modules-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.module-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.module-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(to right, #1890ff, #52c41a);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.module-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.module-card:active::before {
  opacity: 1;
}

.module-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.module-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  text-align: center;
}

.module-desc {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  line-height: 1.5;
}
