<!--index.wxml - 主页-->
<view class="page-container">
  <!-- 顶部：班级选择器 -->
  <view class="class-selector-section">
    <view class="section-title">选择班级</view>
    <picker 
      mode="selector" 
      range="{{classList}}" 
      value="{{currentClassIndex}}"
      bindchange="onClassChange"
      class="class-picker"
    >
      <view class="picker-content">
        <text class="picker-label">{{currentClass || '请选择班级'}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 中部：用户信息展示区 -->
  <view class="user-info-section">
    <view class="section-title">教师信息</view>
    <view class="user-card">
      <image 
        class="user-avatar" 
        src="{{userInfo.avatarUrl}}" 
        mode="aspectFill"
        wx:if="{{hasUserInfo && userInfo.avatarUrl}}"
      ></image>
      <view class="user-avatar-placeholder" wx:else>
        <text class="avatar-icon">👤</text>
      </view>
      <view class="user-details">
        <text class="user-name">{{userInfo.nickName || '未设置昵称'}}</text>
        <text class="user-role">教师</text>
      </view>
    </view>
  </view>

  <!-- 下部：功能模块导航区 -->
  <view class="modules-section">
    <view class="section-title">功能模块</view>
    <view class="modules-grid">
      <view 
        class="module-card" 
        wx:for="{{modules}}" 
        wx:key="id"
        data-path="{{item.path}}"
        bindtap="navigateToModule"
      >
        <view class="module-icon">{{item.icon}}</view>
        <text class="module-name">{{item.name}}</text>
        <text class="module-desc">{{item.description}}</text>
      </view>
    </view>
  </view>
</view>
