<!--module1/index.wxml - 班级生态评估模块-->
<view class="container">
  <view class="header">
    <text class="title">{{title}}</text>
    <button class="refresh-btn" bindtap="reAnalyze" size="mini">重新分析</button>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>分析中...</text>
  </view>

  <!-- 分析结果 -->
  <view class="content" wx:if="{{!loading && analysisResult}}">
    <!-- 网络统计 -->
    <view class="stats-card">
      <view class="stats-title">网络统计</view>
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-value">{{analysisResult.networkStats.totalStudents}}</text>
          <text class="stat-label">总学生数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{analysisResult.networkStats.totalConnections}}</text>
          <text class="stat-label">总连接数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{analysisResult.networkStats.averageDegreeFormatted}}</text>
          <text class="stat-label">平均度数</text>
        </view>
      </view>
    </view>

    <!-- 关系图 -->
    <view class="graph-card" wx:if="{{analysisResult}}">
      <view class="graph-header">
        <view class="graph-title-wrapper">
          <text class="graph-title">📊 社交网络关系图</text>
          <view class="help-icon" bindtap="showHelp">
            <text>❓</text>
          </view>
        </view>
        <button class="reset-btn" bindtap="resetView" size="mini">重置视图</button>
      </view>
      <view class="graph-container">
        <ec-canvas 
          id="networkChart" 
          canvas-id="networkChart" 
          ec="{{ ec }}"
          class="ec-canvas"
        ></ec-canvas>
      </view>
      <view class="graph-tips">
        <text>💡 提示：拖动节点可移动，滚轮或双指可缩放，点击节点查看详情</text>
      </view>
    </view>

    <!-- 意见领袖 -->
    <view class="section-card" wx:if="{{analysisResult.leaders.length > 0}}">
      <view class="section-title">🌟 意见领袖 ({{analysisResult.leaders.length}}人)</view>
      <view class="student-list">
        <view class="student-item leader" wx:for="{{analysisResult.leaders}}" wx:key="id">
          <text class="student-name">{{item.name}}</text>
          <view class="student-scores">
            <text class="score-item">度中心性: {{item.degreeCentralityFormatted}}%</text>
            <text class="score-item">中介中心性: {{item.betweennessCentralityFormatted}}%</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 孤立学生 -->
    <view class="section-card" wx:if="{{analysisResult.isolated.length > 0}}">
      <view class="section-title">⚠️ 需要关注 ({{analysisResult.isolated.length}}人)</view>
      <view class="student-list">
        <view class="student-item isolated" wx:for="{{analysisResult.isolated}}" wx:key="id">
          <text class="student-name">{{item.name}}</text>
          <view class="student-scores">
            <text class="score-item">度中心性: {{item.degreeCentralityFormatted}}%</text>
            <text class="score-item">连接数: {{item.degree}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 详细信息 -->
    <view class="section-card">
      <view class="section-title" bindtap="toggleDetails">
        <text>📊 所有学生详情</text>
        <text class="toggle-icon">{{showDetails ? '▼' : '▶'}}</text>
      </view>
      <view class="detail-list" wx:if="{{showDetails}}">
        <view class="detail-item" wx:for="{{analysisResult.studentList}}" wx:key="id">
          <view class="detail-header">
            <text class="detail-name">{{item.name}}</text>
            <text class="detail-degree">连接数: {{item.degree}}</text>
          </view>
          <view class="detail-scores">
            <text class="detail-score">度中心性: {{item.degreeCentralityFormatted}}%</text>
            <text class="detail-score">中介中心性: {{item.betweennessCentralityFormatted}}%</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && !analysisResult}}">
    <text>暂无数据</text>
  </view>

  <!-- 节点详情弹窗 -->
  <view class="modal" wx:if="{{showNodeModal}}" bindtap="closeNodeModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">学生信息</text>
        <text class="modal-close" bindtap="closeNodeModal">×</text>
      </view>
      <view class="modal-body" wx:if="{{selectedNodeInfo}}">
        <view class="node-info-item">
          <text class="info-label">姓名：</text>
          <text class="info-value">{{selectedNodeInfo.name}}</text>
        </view>
        <view class="node-info-item">
          <text class="info-label">连接数：</text>
          <text class="info-value">{{selectedNodeInfo.degree}}</text>
        </view>
        <view class="node-info-item">
          <text class="info-label">度中心性：</text>
          <text class="info-value">{{selectedNodeInfo.degreeCentrality}}%</text>
        </view>
        <view class="node-info-item">
          <text class="info-label">中介中心性：</text>
          <text class="info-value">{{selectedNodeInfo.betweennessCentrality}}%</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 帮助说明弹窗 -->
  <view class="modal" wx:if="{{showHelpModal}}" bindtap="closeHelpModal">
    <view class="modal-content help-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">关系图说明</text>
        <text class="modal-close" bindtap="closeHelpModal">×</text>
      </view>
      <view class="modal-body">
        <view class="help-section">
          <text class="help-section-title">📊 关系图含义</text>
          <text class="help-content">关系图展示了班级学生之间的社交网络结构。每个圆圈代表一个学生，圆圈之间的连线表示他们之间的朋友关系。</text>
        </view>
        
        <view class="help-section">
          <text class="help-section-title">🎨 节点颜色</text>
          <view class="help-item">
            <view class="help-color-dot" style="background-color: #52c41a;"></view>
            <text class="help-text">绿色：意见领袖（在班级中影响力较大）</text>
          </view>
          <view class="help-item">
            <view class="help-color-dot" style="background-color: #1890ff;"></view>
            <text class="help-text">蓝色：普通学生</text>
          </view>
          <view class="help-item">
            <view class="help-color-dot" style="background-color: #faad14;"></view>
            <text class="help-text">橙色：需要关注（社交关系较少）</text>
          </view>
        </view>

        <view class="help-section">
          <text class="help-section-title">📏 节点大小</text>
          <text class="help-content">节点的大小表示该学生的连接数，连接数越多，节点越大。</text>
        </view>

        <view class="help-section">
          <text class="help-section-title">🔗 连接数</text>
          <text class="help-content">连接数是指一个学生在社交网络中的朋友数量，即与该学生直接相连的其他学生数量。连接数越多，说明该学生的社交关系越丰富。</text>
        </view>

        <view class="help-section">
          <text class="help-section-title">📈 度中心性</text>
          <text class="help-content">度中心性衡量一个学生在社交网络中的直接连接程度。计算公式为：连接数 / (总学生数 - 1)。度中心性越高，说明该学生在班级中的直接影响力越大。</text>
        </view>

        <view class="help-section">
          <text class="help-section-title">🌉 中介中心性</text>
          <text class="help-content">中介中心性衡量一个学生作为"桥梁"的重要性，即有多少对同学之间的最短路径经过该学生。中介中心性高的学生往往是信息传递的关键节点。</text>
        </view>

        <view class="help-section">
          <text class="help-section-title">💡 操作提示</text>
          <text class="help-content">• 拖动节点可以移动位置\n• 双指捏合或滚轮可以缩放视图\n• 点击节点可以查看详细信息\n• 点击"重置视图"可以恢复初始布局</text>
        </view>
      </view>
    </view>
  </view>
</view>
