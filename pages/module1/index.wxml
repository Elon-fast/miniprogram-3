<!--module1/index.wxml - 班级生态评估模块-->
<view class="container">
  <view class="header">
    <text class="title">{{title}}</text>
    <button class="refresh-btn" bindtap="reAnalyze" size="mini">重新分析</button>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>分析中...</text>
  </view>

  <!-- 分析结果 -->
  <view class="content" wx:if="{{!loading && analysisResult}}">
    
    <!-- 1. 班级人际概览 (原网络统计) -->
    <view class="stats-card">
      <view class="card-header">
        <view class="card-title-wrapper">
          <text class="card-icon">👥</text>
          <text class="stats-title">班级人际概览</text>
        </view>
      </view>
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-value">{{analysisResult.networkStats.totalStudents}}</text>
          <text class="stat-label">班级人数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{analysisResult.networkStats.totalConnections}}</text>
          <text class="stat-label">互动总频次</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{analysisResult.networkStats.averageDegreeFormatted}}</text>
          <text class="stat-label">人均朋友数</text>
        </view>
      </view>
    </view>

    <!-- 2. 社交风险预警 (新增功能) -->
    <view class="risk-card" wx:if="{{analysisResult.isolated.length > 0 || concernGroups.length > 0}}">
      <view class="card-header warning-header">
        <view class="card-title-wrapper">
          <text class="card-icon">🔔</text>
          <text class="stats-title">社交风险预警</text>
        </view>
      </view>
      
      <view class="risk-section" wx:if="{{analysisResult.isolated.length > 0}}">
        <view class="risk-title">需关注学生 (孤岛效应)</view>
        <view class="risk-desc">以下学生在调查中未被他人提及或很少提及，建议老师多加关照：</view>
        <view class="student-tags">
          <view class="student-tag warning" wx:for="{{analysisResult.isolated}}" wx:key="id" bindtap="showStudentDetail" data-student="{{item}}">
            {{item.name}}
          </view>
        </view>
      </view>

      <view class="risk-section" wx:if="{{concernGroups.length > 0}}">
        <view class="risk-title">需关注小团体 (封闭圈子)</view>
        <view class="risk-desc">以下小团体内部互动频繁但与外部隔绝，可能存在排他性：</view>
        <view class="group-list">
          <view class="group-item warning" wx:for="{{concernGroups}}" wx:key="id">
            <text class="group-name">{{item.name}}</text>
            <view class="group-members">
              <text wx:for="{{item.members}}" wx:key="*this" wx:for-item="member">{{member}} </text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 3. 社交网络关系图 -->
    <view class="graph-card" wx:if="{{analysisResult}}">
      <view class="graph-header">
        <view class="graph-title-wrapper">
          <text class="card-icon">🕸️</text>
          <text class="graph-title">班级社交网络图</text>
          <view class="help-icon" bindtap="showHelp">
            <text>❓</text>
          </view>
        </view>
        <button class="reset-btn" bindtap="resetView" size="mini">重置视图</button>
      </view>
      <view class="graph-container">
        <ec-canvas 
          id="networkChart" 
          canvas-id="networkChart" 
          ec="{{ ec }}"
          class="ec-canvas"
        ></ec-canvas>
      </view>
      <view class="graph-legend">
        <view class="legend-item"><view class="dot leader"></view><text>核心人物</text></view>
        <view class="legend-item"><view class="dot normal"></view><text>普通学生</text></view>
        <view class="legend-item"><view class="dot isolated"></view><text>需关注</text></view>
      </view>
    </view>

    <!-- 4. 班级整体心理状态 -->
    <view class="psychology-card" wx:if="{{classPsychology}}">
      <view class="card-header">
        <view class="card-title-wrapper">
          <text class="card-icon">❤️</text>
          <text class="section-title">班级心理晴雨表</text>
        </view>
      </view>
      
      <view class="psychology-overview">
        <view class="atmosphere-container">
          <view class="atmosphere-label">整体氛围</view>
          <view class="atmosphere-badge {{classPsychology.classAtmosphere === '正常' ? 'normal' : classPsychology.classAtmosphere === '阳光积极' ? 'positive' : 'concern'}}">
            {{classPsychology.classAtmosphere}}
          </view>
        </view>
        
        <!-- 互动建议 (新增) -->
        <view class="suggestion-box" wx:if="{{classPsychology.concernDimensions.length > 0}}">
          <view class="suggestion-title">💡 改进建议</view>
          <view class="suggestion-content">
            班级在 <text class="highlight">{{classPsychology.concernDimensions[0].name}}</text> 方面得分较高，建议开展相关主题班会或团体辅导活动。
          </view>
        </view>
      </view>

      <view class="dimensions-detail-section">
        <view class="dimensions-chart-container" wx:if="{{ecClassDimensions.onInit}}">
          <ec-canvas 
            id="classDimensionsChart" 
            canvas-id="classDimensionsChart" 
            ec="{{ ecClassDimensions }}"
            class="ec-canvas"
          ></ec-canvas>
        </view>
        
        <view class="dimensions-list">
          <view class="list-header">
            <text>维度名称</text>
            <text>班级均值</text>
            <text>合理区间</text>
          </view>
          <view class="dimension-item" wx:for="{{classPsychology.dimensionList}}" wx:key="key">
            <view class="dimension-info">
              <text class="dimension-name">{{item.name}}</text>
            </view>
            <view class="dimension-value">
              <text class="score {{item.status === 'concern' ? 'concern' : ''}}">{{item.averageFormatted}}</text>
            </view>
            <view class="dimension-range">
              <text class="range-text">1.0 - 2.5</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 5. 所有学生列表 (可点击查看详情) -->
    <view class="section-card">
      <view class="section-title" bindtap="toggleDetails">
        <text>📊 学生综合档案</text>
        <text class="toggle-icon">{{showDetails ? '▼' : '▶'}}</text>
      </view>
      <view class="members-list" wx:if="{{showDetails}}">
        <view 
          class="member-name" 
          wx:for="{{analysisResult.studentList}}" 
          wx:key="id"
          bindtap="showStudentDetail" 
          data-student="{{item}}"
        >
          {{item.name}}
        </view>
      </view>
    </view>

  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && !analysisResult}}">
    <text>暂无数据</text>
  </view>

  <!-- 学生详情弹窗 -->
  <view class="student-detail-modal" wx:if="{{showStudentDetail}}" bindtap="closeStudentDetail">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{selectedStudent.name}} - 详细报告</text>
        <text class="modal-close" bindtap="closeStudentDetail">×</text>
      </view>
      <view class="modal-body">
        <!-- 社交角色分析 (新增) -->
        <view class="social-analysis-section" wx:if="{{selectedStudent.socialStats && selectedStudent.socialStats.length > 0}}">
          <view class="section-subtitle">社交角色分析</view>
          <view class="social-stats-grid">
            <view class="social-stat-item" wx:for="{{selectedStudent.socialStats}}" wx:key="label">
              <text class="social-stat-value">{{item.value}}</text>
              <text class="social-stat-label">{{item.label}}</text>
              <text class="social-stat-desc">({{item.desc}})</text>
            </view>
          </view>
        </view>

        <!-- 心理维度得分 -->
        <view class="student-dimensions">
          <view class="section-subtitle">心理维度评估</view>
          <view class="dimension-detail-item" wx:for="{{selectedStudent.dimensionScores}}" wx:key="key">
            <view class="dimension-detail-header">
              <text class="dimension-detail-name">{{item.name}}</text>
              <view class="dimension-detail-status-badge {{item.status === '正常' ? 'normal' : item.status === '关注' ? 'warning' : 'danger'}}">
                {{item.status}}
              </view>
            </view>
            <view class="dimension-detail-scores">
              <text class="detail-score-label">得分:</text>
              <text class="detail-score-value">{{item.scoreFormatted}}</text>
              <text class="detail-threshold-label">参考值:</text>
              <text class="detail-threshold-value">{{item.thresholdFormatted}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{!selectedStudent.dimensionScores || selectedStudent.dimensionScores.length === 0}}" class="empty">
          暂无详细测评数据
        </view>
      </view>
    </view>
  </view>

  <!-- 帮助说明弹窗 -->
  <view class="modal" wx:if="{{showHelpModal}}" bindtap="closeHelpModal">
    <view class="modal-content help-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">帮助指南</text>
        <text class="modal-close" bindtap="closeHelpModal">×</text>
      </view>
      <view class="modal-body">
        <view class="help-section">
          <text class="help-section-title">📊 关系图说明</text>
          <text class="help-content">关系图展示了班级学生之间的社交网络。圆圈代表学生，连线代表朋友关系。</text>
        </view>
        
        <view class="help-section">
          <text class="help-section-title">🎨 颜色含义</text>
          <view class="help-item">
            <view class="help-color-dot" style="background-color: #ef4444;"></view>
            <text class="help-text">红色：核心人物 (影响力大)</text>
          </view>
          <view class="help-item">
            <view class="help-color-dot" style="background-color: #3b82f6;"></view>
            <text class="help-text">蓝色：普通学生</text>
          </view>
          <view class="help-item">
            <view class="help-color-dot" style="background-color: #9ca3af;"></view>
            <text class="help-text">灰色：需关注 (互动较少)</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 全局 AI 助手 -->
  <ai-assistant />
</view>
