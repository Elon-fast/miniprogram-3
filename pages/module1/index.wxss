/* module1/index.wxss - 班级生态评估模块样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 30rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.refresh-btn {
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.stats-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.stats-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

.section-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.toggle-icon {
  font-size: 24rpx;
  color: #999;
}

.student-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.student-item {
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #1890ff;
}

.student-item.leader {
  background-color: #e6f7ff;
  border-left-color: #1890ff;
}

.student-item.isolated {
  background-color: #fff7e6;
  border-left-color: #faad14;
}

.student-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.student-scores {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.score-item {
  font-size: 24rpx;
  color: #666;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.detail-item {
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.detail-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.detail-degree {
  font-size: 24rpx;
  color: #666;
}

.detail-scores {
  display: flex;
  gap: 20rpx;
}

.detail-score {
  font-size: 24rpx;
  color: #666;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 关系图样式 */
.graph-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.graph-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.graph-title-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.graph-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.help-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
  cursor: pointer;
}

.help-icon:active {
  background-color: #e0e0e0;
}

.reset-btn {
  background-color: #f0f0f0;
  color: #333;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.graph-container {
  width: 100%;
  height: 600rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  margin-bottom: 20rpx;
}

.ec-canvas {
  width: 100%;
  height: 100%;
}

.graph-tips {
  text-align: center;
  padding: 12rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
}

.graph-tips text {
  font-size: 24rpx;
  color: #999;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 85%;
  max-height: 80vh;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.help-modal {
  max-height: 85vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

/* 节点信息样式 */
.node-info-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.node-info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  width: 180rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  flex: 1;
}

/* 帮助说明样式 */
.help-section {
  margin-bottom: 30rpx;
}

.help-section:last-child {
  margin-bottom: 0;
}

.help-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.help-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  display: block;
  white-space: pre-line;
}

.help-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  gap: 12rpx;
}

.help-color-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.help-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  flex: 1;
}
