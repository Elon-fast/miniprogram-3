/* module1/index.wxss - 班级生态评估模块样式 */
.container {
  min-height: 100vh;
  background-color: #f0f2f5; /* 更现代的背景灰 */
  padding: 24rpx;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
}

.refresh-btn {
  background-color: #3b82f6 !important; /* 蓝色按钮 */
  color: #fff !important;
  border-radius: 30rpx !important;
  font-size: 24rpx !important;
  padding: 10rpx 24rpx !important;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #6b7280;
  font-size: 28rpx;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 通用卡片样式 */
.stats-card, .graph-card, .psychology-card, .risk-card, .section-card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 0; /* Flex gap handling margin */
}

/* 卡片头部 */
.card-header, .graph-header, .section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title-wrapper, .graph-title-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-icon {
  font-size: 36rpx;
}

.stats-title, .graph-title, .section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #374151;
  margin: 0; /* Reset */
}

/* 统计网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  background-color: #f9fafb;
  border-radius: 16rpx;
  border: 1px solid #f3f4f6;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #3b82f6;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
}

/* 风险预警卡片 */
.risk-card {
  border-left: 8rpx solid #f59e0b; /* 橙色警示条 */
}

.warning-header .stats-title {
  color: #b45309;
}

.risk-section {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1px dashed #e5e7eb;
}

.risk-section:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.risk-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4b5563;
  margin-bottom: 8rpx;
}

.risk-desc {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 16rpx;
}

.student-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.student-tag {
  padding: 8rpx 20rpx;
  background-color: #e5e7eb;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #374151;
}

.student-tag.warning {
  background-color: #fef3c7;
  color: #d97706;
  border: 1px solid #fcd34d;
}

/* 小团体列表 */
.group-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.group-item {
  background-color: #f9fafb;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  border: 1px solid #f3f4f6;
}

.group-item.warning {
  background-color: #fffbeb;
  border-color: #fcd34d;
}

.group-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #b45309;
  margin-bottom: 4rpx;
}

.group-members {
  font-size: 24rpx;
  color: #6b7280;
}

/* 图表卡片 */
.graph-container {
  height: 500rpx; /* 增加高度 */
  background-color: #fafafa;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1px solid #f3f4f6;
}

.graph-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #6b7280;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot.leader { background-color: #ef4444; } /* 红色代表核心 */
.dot.normal { background-color: #3b82f6; } /* 蓝色代表普通 */
.dot.isolated { background-color: #9ca3af; } /* 灰色代表孤立 */

/* 心理晴雨表 */
.psychology-overview {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.atmosphere-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f0f9ff;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1px solid #bae6fd;
}

.atmosphere-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #0369a1;
}

.atmosphere-badge {
  padding: 6rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.atmosphere-badge.normal {
  background-color: #d1fae5;
  color: #059669;
}

.atmosphere-badge.positive {
  background-color: #fff7ed;
  color: #ea580c;
}

.atmosphere-badge.concern {
  background-color: #fee2e2;
  color: #dc2626;
}

.suggestion-box {
  background-color: #fffbeb;
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #f59e0b;
}

.suggestion-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #b45309;
  margin-bottom: 8rpx;
}

.suggestion-content {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.5;
}

.highlight {
  font-weight: 700;
  text-decoration: underline;
}

/* 维度列表 */
.dimensions-list {
  margin-top: 24rpx;
}

.list-header {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1px solid #e5e7eb;
  font-size: 24rpx;
  color: #9ca3af;
}

.list-header text {
  flex: 1;
  text-align: center;
}

.list-header text:first-child {
  text-align: left;
  flex: 1.5;
}

.dimension-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #f3f4f6;
}

.dimension-item:last-child {
  border-bottom: none;
}

.dimension-info {
  flex: 1.5;
}

.dimension-name {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

.dimension-value {
  flex: 1;
  text-align: center;
}

.score {
  font-size: 30rpx;
  font-weight: 700;
  color: #10b981; /* 默认绿色 */
}

.score.concern {
  color: #ef4444;
}

.dimension-range {
  flex: 1;
  text-align: center;
}

.range-text {
  font-size: 24rpx;
  color: #9ca3af;
  background-color: #f3f4f6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 帮助图标 */
.help-icon {
  background: #f3f4f6;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #6b7280;
}

.reset-btn {
  margin: 0 !important;
  font-size: 22rpx !important;
  background: #fff !important;
  color: #6b7280 !important;
  border: 1px solid #e5e7eb !important;
}

/* 弹窗通用 */
.modal, .student-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-content {
  width: 85%;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 30rpx;
  border-bottom: 1px solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
  padding: 0 16rpx;
}

.modal-body {
  padding: 30rpx;
  overflow-y: auto;
}

/* 社交分析样式 */
.social-analysis-section {
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1px dashed #eee;
}

.section-subtitle {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #3b82f6;
}

.social-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.social-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  background-color: #f0f9ff;
  border-radius: 12rpx;
  text-align: center;
}

.social-stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #0284c7;
  margin-bottom: 6rpx;
}

.social-stat-label {
  font-size: 24rpx;
  color: #475569;
  margin-bottom: 4rpx;
}

.social-stat-desc {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 弹窗内部样式 */
.student-dimensions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dimension-detail-item {
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  border-left: 4rpx solid #1890ff;
}

.dimension-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.dimension-detail-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.dimension-detail-status-badge {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.dimension-detail-status-badge.normal {
  background-color: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.dimension-detail-status-badge.warning {
  background-color: #fff7e6;
  color: #faad14;
  border: 1rpx solid #ffe58f;
}

.dimension-detail-status-badge.danger {
  background-color: #fff1f0;
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
}

.dimension-detail-scores {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
}

.detail-score-label, .detail-threshold-label {
  color: #666;
}

.detail-score-value {
  color: #1890ff;
  font-weight: 600;
  margin-right: 16rpx;
}

.detail-threshold-value {
  color: #999;
}

/* 帮助弹窗内容 */
.help-section {
  margin-bottom: 30rpx;
}

.help-section:last-child {
  margin-bottom: 0;
}

.help-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.help-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.help-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 12rpx;
}

.help-color-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.help-text {
  font-size: 26rpx;
  color: #666;
}

/* 学生列表样式 */
.members-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.member-name {
  padding: 12rpx 24rpx;
  background-color: #e6f7ff;
  color: #1890ff;
  border-radius: 30rpx;
  font-size: 26rpx;
  border: 1px solid #bae7ff;
}
