/** pages/admin/student-edit/index.wxss **/
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 20rpx;
}

/* 列表视图 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title { font-size: 36rpx; font-weight: bold; color: #333; }

.add-btn {
  background: #1890ff;
  color: #fff;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(24,144,255,0.3);
}

.student-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 20rpx;
  max-height: calc(100vh - 120rpx);
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child { border-bottom: none; }

.item-left { display: flex; align-items: center; }
.item-left .name { font-size: 32rpx; color: #333; margin-right: 20rpx; font-weight: 500; }
.item-left .id { font-size: 24rpx; color: #999; background: #f5f5f5; padding: 4rpx 8rpx; border-radius: 4rpx; }

.item-right .edit-icon { color: #999; font-size: 32rpx; }

/* 编辑视图 */
.edit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.back-btn { font-size: 30rpx; color: #666; }

.form-container {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-sizing: border-box;
  height: calc(100vh - 120rpx);
}

.form-section { margin-bottom: 40rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 24rpx; border-left: 6rpx solid #1890ff; padding-left: 16rpx; }

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f9f9f9;
}

.label { width: 120rpx; font-size: 30rpx; color: #666; }
.input { flex: 1; font-size: 30rpx; color: #333; }

.radio-group radio { margin-right: 30rpx; transform: scale(0.8); }

/* 职务 & 好友选择 */
.roles-group, .friends-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.checkbox-label, .friend-label {
  font-size: 28rpx;
  color: #666;
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.friend-tip { font-size: 24rpx; color: #999; margin-bottom: 16rpx; }

/* 成绩网格 */
.scores-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.score-item {
  display: flex;
  flex-direction: column;
  background: #f9f9f9;
  padding: 16rpx;
  border-radius: 8rpx;
}

.score-item.psy { background-color: #fff7e6; } /* 心理数据背景色区分 */

.score-label { font-size: 24rpx; color: #666; margin-bottom: 8rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.score-input { font-size: 32rpx; font-weight: bold; color: #333; height: 40rpx; min-height: 40rpx; }

.save-btn {
  background: #1890ff; color: #fff; margin-top: 40rpx; font-size: 32rpx; border-radius: 40rpx;
}

.delete-btn {
  background: #fff; color: #ff4d4f; margin-top: 20rpx; font-size: 32rpx; border-radius: 40rpx; border: 1rpx solid #ff4d4f;
}
