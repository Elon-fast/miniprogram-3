/* module3/index.wxss - 班委胜任力模型模块样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 30rpx;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.view-tabs {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #1890ff;
  color: #fff;
  font-weight: 600;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 学生视角样式 */
.student-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.student-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.student-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.recommendation-badge {
  background-color: #52c41a;
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.position-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.position-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.position-name {
  width: 160rpx;
  font-size: 26rpx;
  color: #333;
}

.fitness-bar {
  flex: 1;
  height: 16rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.fitness-fill {
  height: 100%;
  background: linear-gradient(to right, #1890ff, #52c41a);
  border-radius: 8rpx;
  transition: width 0.3s;
}

.fitness-value {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  color: #666;
  font-weight: 600;
}

/* 岗位视角样式 */
.position-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.position-header {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.position-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.position-desc {
  font-size: 24rpx;
  color: #666;
}

.candidates-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.candidate-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.candidate-rank {
  width: 48rpx;
  height: 48rpx;
  background-color: #1890ff;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

.candidate-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.candidate-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.candidate-fitness {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-height: 80vh;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.detail-position-item {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-position-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.detail-position-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.detail-position-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.detail-position-percent {
  font-size: 28rpx;
  font-weight: 600;
  color: #1890ff;
}

.detail-fitness-bar {
  height: 20rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.detail-fitness-fill {
  height: 100%;
  background: linear-gradient(to right, #1890ff, #52c41a);
  border-radius: 10rpx;
}

.detail-position-desc {
  font-size: 24rpx;
  color: #666;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
