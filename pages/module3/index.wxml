<!--module3/index.wxml - 班委胜任力模型模块-->
<view class="container">
  <view class="header">
    <text class="title">{{title}}</text>
  </view>

  <!-- 视图切换 -->
  <view class="view-tabs" wx:if="{{!loading && recommendations.length > 0}}">
    <view 
      class="tab-item {{selectedView === 'students' ? 'active' : ''}}"
      data-view="students"
      bindtap="switchView"
    >
      学生视角
    </view>
    <view 
      class="tab-item {{selectedView === 'positions' ? 'active' : ''}}"
      data-view="positions"
      bindtap="switchView"
    >
      岗位视角
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>分析中...</text>
  </view>

  <!-- 学生视角 -->
  <view class="content" wx:if="{{!loading && selectedView === 'students' && recommendations.length > 0}}">
    <view class="student-card" wx:for="{{recommendations}}" wx:key="student.id" data-index="{{index}}" bindtap="viewStudentDetail">
      <view class="student-header">
        <text class="student-name">{{item.student.name}}</text>
        <view class="recommendation-badge" wx:if="{{item.recommendedPosition}}">
          <text>推荐: {{item.recommendedPosition.name}}</text>
        </view>
      </view>
      
      <view class="position-list">
        <view class="position-item" wx:for="{{item.sortedPositions}}" wx:key="name" wx:for-item="pos">
          <text class="position-name">{{pos.name}}</text>
          <view class="fitness-bar">
            <view class="fitness-fill" style="width: {{pos.percentage}}%"></view>
          </view>
          <text class="fitness-value">{{pos.percentage}}%</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 岗位视角 -->
  <view class="content" wx:if="{{!loading && selectedView === 'positions' && positionCandidates}}">
    <view class="position-card" wx:for="{{positionCandidates}}" wx:key="position.name" wx:for-item="posData">
      <view class="position-header">
        <text class="position-title">{{posData.position.name}}</text>
        <text class="position-desc">{{posData.position.description}}</text>
      </view>
      
      <view class="candidates-list">
        <view class="candidate-item" wx:for="{{posData.candidates}}" wx:key="student.id" wx:for-item="candidate">
          <view class="candidate-rank">{{index + 1}}</view>
          <view class="candidate-info">
            <text class="candidate-name">{{candidate.student.name}}</text>
            <view class="candidate-fitness">
              <view class="fitness-bar">
                <view class="fitness-fill" style="width: {{candidate.percentage}}%"></view>
              </view>
              <text class="fitness-value">{{candidate.percentage}}%</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 学生详情弹窗 -->
  <view class="modal" wx:if="{{selectedStudent}}" bindtap="closeStudentDetail">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{selectedStudent.student.name}} - 岗位适配度</text>
        <text class="modal-close" bindtap="closeStudentDetail">×</text>
      </view>
      <view class="modal-body">
        <view class="detail-position-item" wx:for="{{selectedStudent.sortedPositions}}" wx:key="name">
          <view class="detail-position-header">
            <text class="detail-position-name">{{item.name}}</text>
            <text class="detail-position-percent">{{item.percentage}}%</text>
          </view>
          <view class="detail-fitness-bar">
            <view class="detail-fitness-fill" style="width: {{item.percentage}}%"></view>
          </view>
          <text class="detail-position-desc">{{item.position.description}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && recommendations.length === 0}}">
    <text>暂无数据</text>
  </view>
</view>
