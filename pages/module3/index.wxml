<!--module3/index.wxml - 班委胜任力模型模块-->
<view class="container">
  <view class="header">
    <text class="title">{{title}}</text>
  </view>

  <!-- 1. 现任班委公示 -->
  <view class="section-card current-leaders-section" wx:if="{{positions.length > 0}}">
    <view class="section-title">🏆 现任班委</view>
    <scroll-view class="leaders-scroll" scroll-x="true" enable-flex="true">
      <view class="leader-card" wx:for="{{positions}}" wx:key="id" wx:if="{{item.currentHolder}}">
        <view class="leader-avatar">{{item.currentHolder.name[0]}}</view>
        <text class="leader-name">{{item.currentHolder.name}}</text>
        <text class="leader-role">{{item.name}}</text>
      </view>
      <view class="leader-card empty" wx:if="{{!hasAnyHolder}}">
        <text class="empty-text">暂无任命</text>
      </view>
    </scroll-view>
  </view>

  <!-- 2. 岗位管理与推荐 -->
  <view class="positions-container">
    <view class="section-title-row">
      <text class="section-title">📋 岗位胜任力推荐</text>
    </view>

    <view class="position-card" wx:for="{{positions}}" wx:key="id">
      <view class="position-header">
        <view class="position-info">
          <text class="position-name">{{item.name}}</text>
          <text class="position-desc">{{item.description}}</text>
        </view>
        <button class="appoint-btn" size="mini" bindtap="showAppointModal" data-id="{{item.id}}">任命</button>
      </view>

      <view class="candidates-list">
        <view class="candidate-item" wx:for="{{item.candidates}}" wx:key="idx" wx:for-item="candidate" wx:for-index="idx">
          <view class="candidate-rank rank-{{idx + 1}}">{{idx + 1}}</view>
          <view class="candidate-info">
            <text class="candidate-name">{{candidate.student.name}}</text>
            <view class="fitness-bar-container">
              <view class="fitness-bar">
                <view class="fitness-fill" style="width: {{candidate.percentage}}%"></view>
              </view>
              <text class="fitness-value">{{candidate.percentage}}%</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部添加按钮 -->
  <view class="add-btn-container">
    <button class="add-position-btn" bindtap="showAddPosition">+ 添加自定义岗位</button>
  </view>

  <!-- 添加岗位弹窗 -->
  <view class="modal" wx:if="{{showAddPositionModal}}" bindtap="closeAddPositionModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">添加自定义岗位</text>
        <text class="modal-close" bindtap="closeAddPositionModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">岗位名称</text>
          <input class="form-input" placeholder="例如：卫生委员" value="{{editingPosition.name}}" bindinput="onPositionNameInput" />
        </view>
        
        <view class="form-item">
          <text class="form-label">能力权重配置 (请拖动调整比重)</text>
          <view class="weights-list">
            <view class="weight-item" wx:for="{{abilityOptions}}" wx:key="key">
              <view class="weight-header">
                <text class="weight-name">{{item.name}}</text>
                <text class="weight-value">{{editingPosition.weights[item.key]}}%</text>
              </view>
              <slider 
                min="0" max="100" step="5" 
                value="{{editingPosition.weights[item.key]}}" 
                data-key="{{item.key}}" 
                bindchange="onWeightChange"
                activeColor="#1890ff"
                block-size="12"
              />
            </view>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="confirm-btn" bindtap="saveNewPosition">确认添加</button>
      </view>
    </view>
  </view>

  <!-- 任命选择弹窗 -->
  <view class="modal" wx:if="{{showAppointModal}}" bindtap="closeAppointModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">选择任命人选</text>
        <text class="modal-close" bindtap="closeAppointModal">×</text>
      </view>
      <view class="modal-body">
        <block wx:for="{{positions}}" wx:key="id">
          <view wx:if="{{item.id === currentAppointingPositionId}}">
            <view class="candidate-select-list">
              <view 
                class="candidate-select-item" 
                wx:for="{{item.candidates}}" 
                wx:key="student.id" 
                wx:for-item="candidate"
                bindtap="confirmAppoint"
                data-student="{{candidate.student}}"
              >
                <view class="candidate-select-info">
                  <text class="candidate-select-name">{{candidate.student.name}}</text>
                  <text class="candidate-select-score">匹配度: {{candidate.percentage}}%</text>
                </view>
                <view class="select-icon">👉</view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 全局 AI 助手 -->
  <ai-assistant />
</view>
