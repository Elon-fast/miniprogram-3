/* components/ai-assistant/index.wxss */
:host {
  display: block;
  width: 0;
  height: 0;
  overflow: visible;
  position: relative;
  z-index: 999999;
}

/* 悬浮球 */
.floating-ball {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx; /* 避开底部 TabBar 或其他按钮 */
  width: 100rpx;
  height: 100rpx;
  background-color: #1890ff;
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 999999 !important; /* 确保最高层级 */
}

.floating-ball:active {
  transform: scale(0.9);
}

.floating-ball.hidden {
  transform: scale(0);
  opacity: 0;
  pointer-events: none;
}

.icon {
  font-size: 50rpx;
}

/* 聊天面板 */
.chat-panel {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 600rpx;
  height: 800rpx;
  background-color: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform-origin: bottom right;
  transform: scale(0);
  opacity: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 999999 !important; /* 确保最高层级 */
  pointer-events: none;
}

.chat-panel.visible {
  transform: scale(1);
  opacity: 1;
  pointer-events: auto;
}

/* 面板头部 */
.panel-header {
  padding: 20rpx 30rpx;
  background-color: #1890ff;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
}

.close-btn {
  font-size: 40rpx;
  line-height: 1;
  padding: 0 10rpx;
}

/* 聊天记录 */
.chat-history {
  flex: 1;
  padding: 20rpx;
  background-color: #f5f7fa;
  overflow-y: auto;
}

.welcome-msg {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
  line-height: 1.6;
}

.message-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.message-item.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
}

.user-avatar {
  background-color: #1890ff;
  margin-left: 16rpx;
}

.ai-avatar {
  background-color: #52c41a;
  margin-right: 16rpx;
}

.bubble {
  max-width: 400rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.user .bubble {
  background-color: #e6f7ff;
  color: #333;
  border-top-right-radius: 4rpx;
}

.ai .bubble {
  background-color: #fff;
  color: #333;
  border: 1px solid #e8e8e8;
  border-top-left-radius: 4rpx;
}

/* 底部操作区 */
.panel-footer {
  padding: 20rpx;
  background-color: #fff;
  border-top: 1px solid #f0f0f0;
}

.record-btn {
  width: 100%;
  height: 80rpx;
  background-color: #f0f0f0;
  color: #333;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.record-btn:active, .record-btn.recording {
  background-color: #1890ff;
  color: #fff;
  transform: scale(0.98);
}

/* 录音提示 Toast */
.recording-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.8);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 999999 !important;
}

.wave-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.wave {
  width: 8rpx;
  height: 20rpx;
  background-color: #fff;
  border-radius: 4rpx;
  animation: wave 1s infinite ease-in-out;
}

.wave:nth-child(1) { animation-delay: 0s; }
.wave:nth-child(2) { animation-delay: 0.2s; }
.wave:nth-child(3) { animation-delay: 0.4s; }

@keyframes wave {
  0%, 100% { height: 20rpx; opacity: 0.5; }
  50% { height: 50rpx; opacity: 1; }
}

.toast-text {
  color: #fff;
  font-size: 28rpx;
}
